export type Player = { id: string; name: string; score: number }
export type Question = {
  question_text: string
  options: string[]
  correct_answer: 'A'|'B'|'C'|'D'
  time_limit: number
  points_correct: number
  points_incorrect: number
  theme?: string | null
  age_groups?: { junior: number; teenager: number; classic: number }
}
export type Round = { id: string; category: string; questions: Question[] }
export type Game = {
  id: string
  code: string
  status: 'waiting'|'active'|'finished'
  settings: Record<string, any>
  players: Player[]
  rounds: Round[]
  createdAt: number
}

function rand(n: number) { return Math.floor(Math.random()*n) }
function pickCode(len = 6) {
  const alph = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'
  return Array.from({length: len}, () => alph[rand(alph.length)]).join('')
}
function uuid() {
  return (globalThis.crypto?.randomUUID)
    ? globalThis.crypto.randomUUID()
    : `${Date.now()}-${Math.random()}`;
}- }

export const store = {
  games: new Map<string, Game>(),

  createGame(settings: Record<string,any> = {}) {
    const code = pickCode(6)
    const game: Game = {
      id: uuid(),
      code,
      status: 'waiting',
      settings,
      players: [],
      rounds: [],
      createdAt: Date.now()
    }
    this.games.set(code, game)
    return game
  },

  getGame(code: string) {
    return this.games.get(code) || null
  },

  addRound(code: string, category: string, questions: Question[]) {
    const g = this.getGame(code)
    if (!g) return null
    const r: Round = { id: uuid(), category, questions }
    g.rounds.push(r)
    return r
  },

  addBulkQuestions(code: string, questions: Question[]) {
    // alternatívny import (napr. ak si otázky vyberieš sám)
    return this.addRound(code, 'bulk', questions)
  }
}

